# Número máximo de avisos por usuario antes de expulsarlo.
MAX_WARNINGS=3

# true = todo sticker cuenta como infracción (modo recomendado y determinista).
# false = el bot no actuará sobre stickers.
BLOCK_ALL_STICKERS=true

# Mensajes del bot.
WARNING_MESSAGE=⚠️ Sticker no permitido. Aviso {count}/{max}.
KICK_MESSAGE=🚫 Has alcanzado {max} avisos y has sido expulsado del grupo.

# true = no sancionar administradores del grupo.
EXEMPT_ADMINS=true

# Zona horaria de los registros.
TZ=Europe/Madrid
